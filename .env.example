# ==============================================================================
# MAT-VLAB Environment Configuration Template
# Copy this file to .env and configure for your production server or PaaS.
# Do NOT commit sensitive production secret keys to version control.
# ==============================================================================

# Application Environment: 'production' or 'development'
FLASK_ENV=production

# Secret Key for session signing & CSRF protection
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-cryptographically-secure-random-key-in-production

# Network Host & Port Binding
# Most cloud platforms automatically assign $PORT (e.g. 80, 443, 8080, 10000)
HOST=0.0.0.0
PORT=5000

# HTTPS Reverse Proxy & Load Balancer Integration
# Set to 'true' when hosted on Render, Railway, AWS, Cloudflare, or Nginx
ENABLE_PROXY_FIX=true
PREFERRED_URL_SCHEME=https

# Storage & Database Locations
# For cloud containers with persistent disks, point to the mount directory
DATABASE_PATH=materials.db
DATA_DIR=data
UPLOAD_FOLDER=data/uploads

# Maximum upload limit (16MB in bytes)
MAX_CONTENT_LENGTH=16777216

# Gunicorn Worker Process Tuning
WEB_CONCURRENCY=2
PYTHON_THREADS=2
TIMEOUT=60
LOG_LEVEL=info

# Private Administrator Portal Configuration
# (Can also be changed dynamically inside the web portal at /portal-admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=matvlab_admin_2024
ADMIN_URL_PATH=/portal-admin

